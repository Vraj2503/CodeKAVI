# ── API Keys & Credentials ──
GROQ_API_KEY=your-groq-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-here
ZILLIZ_URI=your-zilliz-uri-here
ZILLIZ_API_KEY=your-zilliz-api-key-here
# Local dev: redis://localhost:6379/0
# Production (TLS): rediss://your-redis-host:6380/0 (recommended for AWS ElastiCache, Upstash, Redis Cloud)
REDIS_URL=redis://localhost:6379/0
SUPABASE_URL=your-supabase-url-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── Optional/CORS Config ──
CORS_ORIGINS=http://localhost:3000

# ── Model Names ──
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=gemini-embedding-2

# RAG embeddings. The default keeps the existing Cloudflare behaviour.
# To use LM Studio, set EMBEDDING_PROVIDER=local and start the Local Model API.
EMBEDDING_PROVIDER=cloudflare
# Fallback when local is unreachable: cloudflare (default) or none (mandatory for speed tests).
EMBEDDING_FALLBACK=cloudflare
LOCAL_EMBEDDING_BASE_URL=http://localhost:1234/v1
LOCAL_EMBEDDING_MODEL=text-embedding-bge-large-en-v1.5
LOCAL_EMBEDDING_POOLING=cls
# Optional for servers that require authentication. LM Studio normally needs none.
LOCAL_EMBEDDING_API_KEY=
# Keep these blank until measured for the selected model. A document-prefix
# change requires re-indexing because it changes stored vectors.
LOCAL_EMBEDDING_DOCUMENT_PREFIX=
LOCAL_EMBEDDING_QUERY_PREFIX=
# Optional absolute path to the selected model's tokenizer.json. With this
# blank CodeKAVI uses the matching tokenizer in the local Hugging Face cache.
# One-time setup:
#   backend\.venv\Scripts\hf.exe download BAAI/bge-large-en-v1.5 tokenizer.json
#   backend\.venv\Scripts\hf.exe download Qwen/Qwen3-Embedding-0.6B tokenizer.json
LOCAL_EMBEDDING_TOKENIZER_PATH=
LOCAL_EMBEDDING_TIMEOUT_S=30
LOCAL_EMBEDDING_CHUNK_OVERLAP_TOKENS=64
# Target chunk size in tokens (0 = model default, e.g. 512).
LOCAL_EMBEDDING_CHUNK_TOKENS=0
# Hard token limit ceiling (0 = model maximum, e.g. 512 for bge-large, 32768 for qwen3).
LOCAL_EMBEDDING_MAX_TOKENS=0
# Number of chunks per POST to the local embedding server (default 32).
LOCAL_EMBEDDING_BATCH_SIZE=32
# Pause between successful embedding batches. Set to 0 for faster local tests.
INDEXER_BATCH_DELAY_S=0

# ── Bounded cache / limits ──
MAX_CONTENT_CACHE_BYTES=10485760
REPO_SIZE_LIMIT_BYTES=104857600
REPO_FILE_LIMIT=2000

# ── Rate Limiting ──
RATE_LIMIT_IP_RPM=60
RATE_LIMIT_USER_RPM=20

# ── Daily Quotas ──
DAILY_USER_TOKEN_QUOTA=200000
GLOBAL_DAILY_SPEND_LIMIT_USD=5.0
